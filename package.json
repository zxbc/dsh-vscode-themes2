{
  "name": "dsh-vscode-themes2",
  "version": "1.1.0",
  "description": "Browse, search, install, and apply VS Code color themes to the DeepSeek Harness Web UI — one click re-skins the whole interface live.",
  "keywords": ["dsh", "deepseek-harness", "plugin", "vscode", "themes", "vscode-themes", "ui", "theme", "skin"],
  "license": "MIT",
  "author": "zxbc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxbc/dsh-vscode-themes2.git"
  },
  "homepage": "https://github.com/zxbc/dsh-vscode-themes2",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./marketplace.js": "./marketplace.js",
    "./update.js": "./update.js"
  },
  "files": ["index.js", "client.js", "marketplace.js", "update.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dependencies": {},
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
